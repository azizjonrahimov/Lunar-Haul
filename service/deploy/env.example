# /etc/lunarsim/env  (chmod 600, owned by root; read by the systemd units through EnvironmentFile)
# Every LUNARSIM_* variable is documented in service/README.md. Unset values keep the defaults in service/settings.py.

# --- where things live ---------------------------------------------------------------------------------------
LUNARSIM_DATA_DIR=/var/lib/lunarsim                 # lunarsim.db + blobs/
LUNARSIM_REPO_ROOT=/srv/lunarsim/repo               # git provenance, data/, experiments/
LUNARSIM_LOG_LEVEL=INFO

# --- URLs and origins (cookies need app.<domain> and api.<domain> on the same registrable domain) ---------------
LUNARSIM_BASE_URL=https://api.example.org
LUNARSIM_APP_URL=https://app.example.org
LUNARSIM_ALLOWED_ORIGINS=https://app.example.org,https://azizjonrahimov.github.io
LUNARSIM_TRUST_PROXY=1                              # behind Caddy: client IP from X-Forwarded-For
LUNARSIM_COOKIE_SECURE=1
LUNARSIM_SESSION_TTL_H=168
LUNARSIM_MAGIC_TTL_MIN=15

# --- sign-in providers (leave empty to disable; /v2/auth/<p>/start then answers 503) ----------------------------
LUNARSIM_ORCID_CLIENT_ID=
LUNARSIM_ORCID_CLIENT_SECRET=
LUNARSIM_ORCID_SANDBOX=0                            # 1 while testing against sandbox.orcid.org
LUNARSIM_GITHUB_CLIENT_ID=
LUNARSIM_GITHUB_CLIENT_SECRET=

# --- magic-link e-mail -----------------------------------------------------------------------------------------
LUNARSIM_MAIL_MODE=smtp                             # log (development: link goes to the log) | smtp
LUNARSIM_MAIL_FROM=LunarSim <no-reply@example.org>
LUNARSIM_SMTP_HOST=smtp.example.org
LUNARSIM_SMTP_PORT=587
LUNARSIM_SMTP_USER=
LUNARSIM_SMTP_PASSWORD=
LUNARSIM_SMTP_STARTTLS=1

# --- limits and quotas -------------------------------------------------------------------------------------------
LUNARSIM_MAX_SEEDS=100
LUNARSIM_MAX_BODY_BYTES=1048576
LUNARSIM_MAX_QUEUED_PER_USER=5
LUNARSIM_QUOTA_CPU_S_PER_DAY=1800                   # signed-in accounts
LUNARSIM_QUOTA_ANON_CPU_S_PER_DAY=300               # per IP
LUNARSIM_CPU_S_PER_SEED_ESTIMATE=1.0
LUNARSIM_ALLOW_ANON_RUNS=1
# LUNARSIM_RATE_LIMITS={"auth_magic":"5/minute","runs_create":"10/minute"}

# --- worker ------------------------------------------------------------------------------------------------------
LUNARSIM_WORKER_POLL_S=1.0
LUNARSIM_WORKER_STALE_S=3600

# --- Litestream (S3-compatible bucket) ------------------------------------------------------------------------------
LITESTREAM_BUCKET=lunarsim-backup
LITESTREAM_ENDPOINT=https://fsn1.your-objectstorage.com
LITESTREAM_REGION=fsn1
LITESTREAM_ACCESS_KEY_ID=
LITESTREAM_SECRET_ACCESS_KEY=
