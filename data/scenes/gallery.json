{
 "format": "lunarsim-scene-gallery",
 "version": 1,
 "description": "Curated years of the base for the 3D world: each scene is a replay of one simulated year (a lunarsim-scene v1 package under data/scenes/<package>) with headline numbers over 20 seeds of the same settings.",
 "common": {
  "terrain": "connecting_ridge",
  "landing_model": "classical",
  "plume": {
   "keepout_km": 1.0,
   "standdown_h": 0.5
  },
  "autonomy_model": "driving-v1",
  "replay_seed": 3,
  "seeds": 20,
  "note": "scenes with flags.matches reproduce an E21 cell: no plume (flags.plume null) and E21's link-series year per seed (flags.start_year)"
 },
 "metrics": [
  {
   "key": "delivered_t",
   "label": "Cargo delivered in the year",
   "unit": "t",
   "digits": 0,
   "flag": "Modelled"
  },
  {
   "key": "delay_prio1_mean_h",
   "label": "Mean wait of urgent cargo",
   "unit": "h",
   "digits": 1,
   "flag": "Modelled"
  },
  {
   "key": "delay_prio1_p90_h",
   "label": "One in ten urgent items waits longer than",
   "unit": "h",
   "digits": 0,
   "flag": "Modelled"
  },
  {
   "key": "sl24_prio1",
   "label": "Urgent items delivered within a day",
   "unit": "%",
   "digits": 0,
   "flag": "Modelled"
  },
  {
   "key": "cost_per_landed_kg_usd",
   "label": "Surface cost per landed kg",
   "unit": "$/kg",
   "digits": 0,
   "flag": "Modelled"
  },
  {
   "key": "blackout_wait_vehicle_h",
   "label": "Rover-hours waiting for Earth",
   "unit": "h",
   "digits": 0,
   "flag": "Modelled"
  }
 ],
 "groups": [
  {
   "id": "phases",
   "title": "Three phases, two job rules",
   "description": "The base as it grows, with each company running its own rovers or every rover taking any job."
  },
  {
   "id": "pads",
   "title": "How far the pads are",
   "description": "The second phase with the shared job rule and the landing pads nearer or farther than the usual distance."
  },
  {
   "id": "earth",
   "title": "Earth below the horizon",
   "description": "The second phase when supervised rovers need Earth in view, with and without a relay or autonomy."
  },
  {
   "id": "fleet",
   "title": "A small fleet",
   "description": "The second phase with fewer rovers."
  }
 ],
