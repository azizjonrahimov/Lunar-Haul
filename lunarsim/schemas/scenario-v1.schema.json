{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azizjonrahimov.github.io/lunar-logistics-research/schemas/scenario-v1.schema.json",
  "title": "lunarsim-scenario v1",
  "description": "Simulation inputs. Two forms, told apart by 'form' (missing: a document with 'phase' is compact, else full). Header keys are optional on input (pre-v1 files have none). Mapping between the forms: lunarsim/config.py (_from_compact, split_rtt).",
  "type": "object",
  "properties": {
    "format": {
      "const": "lunarsim-scenario"
    },
    "version": {
      "const": 1
    },
    "form": {
      "enum": [
        "full",
        "compact"
      ]
    }
  },
  "if": {
    "anyOf": [
      {
        "properties": {
          "form": {
            "const": "compact"
          }
        },
        "required": [
          "form"
        ]
      },
      {
        "not": {
          "required": [
            "form"
          ]
        },
        "required": [
          "phase"
        ]
      }
    ]
  },
  "then": {
    "$ref": "#/$defs/compact"
  },
  "else": {
    "$ref": "#/$defs/full"
  },
  "$defs": {
    "fleetEntry": {
      "description": "[owner, class, autonomy, standards]; standards may be 'A' or e.g. 'A|B'",
      "oneOf": [
        {
          "type": "array",
          "prefixItems": [
            {
              "type": "string"
            },
            {
              "enum": [
                "LTV",
                "HAUL",
                "MICRO"
              ]
            },
            {
              "enum": [
                "teleop",
                "supervised",
                "autonomous"
              ]
            },
            {
              "type": "string"
            }
          ],
          "minItems": 3,
          "maxItems": 4
        },
        {
          "type": "object",
          "required": [
            "owner",
            "cls"
          ],
          "additionalProperties": false,
          "properties": {
            "owner": {
              "type": "string"
            },
            "cls": {
              "enum": [
                "LTV",
                "HAUL",
                "MICRO"
              ]
            },
            "autonomy": {
              "enum": [
                "teleop",
                "supervised",
                "autonomous"
              ]
            },
            "std": {
              "type": "string"
            }
          }
        }
      ]
    },
    "bulkFlow": {
      "type": "object",
      "required": [
        "origin",
        "dest",
        "tonnes_per_year"
      ],
      "additionalProperties": false,
      "properties": {
        "origin": {
          "type": "string"
        },
        "dest": {
          "type": "string"
        },
        "tonnes_per_year": {
          "type": "number",
          "minimum": 0
        },
        "lot_kg": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "owner": {
          "type": "string"
        },
        "priority": {
          "type": "integer",
          "minimum": 1,
          "maximum": 3
        },
        "start_h": {
          "type": "number"
        }
      }
    },
    "full": {
      "type": "object",
      "additionalProperties": false,
      "description": "Every field of lunarsim.scenario.Scenario; missing fields take the Scenario defaults.",
      "properties": {
        "format": true,
        "version": true,
        "form": {
          "const": "full"
        },
        "name": {
          "type": "string"
        },
        "horizon_h": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "landings_per_year": {
          "type": "object",
          "additionalProperties": {
            "type": "number",
            "minimum": 0
          }
        },
        "cargo_owners": {
          "type": "array",
          "items": {
            "type": "string"
          },
          "minItems": 1
        },
        "bulk_flows": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/bulkFlow"
          }
        },
        "fleet": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fleetEntry"
          }
        },
        "night_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "night_speed_mult": {
          "type": "number",
          "minimum": 0
        },
        "one_way_latency_s": {
          "type": "number",
          "minimum": 0
        },
        "ground_delay_s": {
          "type": "number",
          "minimum": 0
        },
        "n_operators": {
          "type": "integer",
          "minimum": 0
        },
        "supervised_fanout": {
          "type": "integer",
          "minimum": 1
        },
        "failures": {
          "type": "boolean"
        },
        "mtbf_mult": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "other_duty_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "other_duty_block_h": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "common_standard_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "operator_cost_per_h": {
          "type": "number"
        },
        "urgency_usd_per_h": {
          "type": "number"
        },
        "vot_usd_per_h": {
          "type": "object",
          "propertyNames": {
            "pattern": "^[0-9]+$"
          },
          "additionalProperties": {
            "type": "number"
          }
        },
        "delivered_value_per_kg": {
          "type": "number"
        },
        "seed": {
          "type": "integer"
        },
        "terrain": {
          "type": [
            "string",
            "null"
          ],
          "description": "Phase 3: terrain pack id (data/terrain/<id>/sites.json)"
        },
        "pad_standoff_km": {
          "type": [
            "string",
            "number",
            "null"
          ],
          "description": "Phase 3: key into sites.json pads (default \"1\")"
        },
        "landing_model": {
          "type": [
            "object",
            "null"
          ],
          "description": "Phase 3: {policy: \"classical\"|id|{cls: id}, sigma_scale, pad_radius_m, failure_policy: \"lose\"|{recover_h}, dir}",
          "properties": {
            "policy": {
              "type": [
                "string",
                "object"
              ]
            },
            "sigma_scale": {
              "type": "number",
              "minimum": 0
            },
            "pad_radius_m": {
              "type": "number",
              "exclusiveMinimum": 0
            },
            "failure_policy": {
              "oneOf": [
                {
                  "const": "lose"
                },
                {
                  "type": "object",
                  "required": [
                    "recover_h"
                  ],
                  "properties": {
                    "recover_h": {
                      "type": "number",
                      "minimum": 0
                    }
                  }
                }
              ]
            },
            "dir": {
              "type": "string"
            }
          }
        },
        "plume": {
          "type": [
            "object",
            "null"
          ],
          "required": [
            "keepout_km",
            "standdown_h"
          ],
          "description": "Phase 3: plume keep-out windows",
          "properties": {
            "keepout_km": {
              "type": "number",
              "minimum": 0
            },
            "standdown_h": {
              "type": "number",
              "minimum": 0
            },
            "shelter": {
              "const": "auto"
            },
            "return_after": {
              "type": "boolean",
              "description": "evacuated vehicles return to their pre-evacuation site after the window (default true)"
            }
          }
        },
        "autonomy_model": {
          "type": [
            "string",
            "null"
          ],
          "description": "Phase 3: \"driving-v1\" or a path to a lunarsim-driving table"
        },
        "illumination": {
          "type": ["object", "null"],
          "description": "Phase 4 (B-44): real sun per site and leg (lunarsim/illumination.py). Absent or null = the night_fraction rule (v2 results).",
          "additionalProperties": false,
          "properties": {
            "file": {"type": "string", "description": "path to sun_link-v1.json (default data/illumination/connecting_ridge/sun_link-v1.json)"},
            "criterion": {"enum": ["any_part", "half", "full"], "description": "lit when some / half / all of the solar disc is above the local horizon (default half, Assumed)"},
            "leg_rule": {"enum": ["most", "worst"], "description": "a leg is lit when >= 80 % of its route samples are (default; Assumed: short shadows on battery) / when every sample is"},
            "start_year": {"enum": [2028, 2029, 2030, 2031], "description": "default: the comms start_year when comms is set, else 2028"},
            "start_h": {"type": "number", "minimum": 0, "description": "hours after 2028-01-01 00:00 UTC that engine hour 0 maps to (overrides start_year)"}
          }
        },
        "comms": {
          "type": ["object", "null"],
          "description": "Phase 4 (R-1): Earth-link rules (lunarsim/comms.py CommsModel). Absent or null = no rule; mode 'always' gives identical results.",
          "additionalProperties": false,
          "properties": {
            "mode": {"enum": ["always", "dte", "dte+relay"]},
            "criterion": {"enum": ["any_part", "centre+0.5deg", "centre+2deg"]},
            "operators_strict": {"type": "boolean", "description": "B-45: operators are a hard capacity in the linked modes (vehicles that need a link wait for a free operator); default false"},
            "link_series": {"type": "string", "description": "path to earth_link-v1.json (default data/comms/connecting_ridge/earth_link-v1.json)"},
            "relay": {
              "type": "object",
              "description": "Assumed: the relay sees every route point (no relay terrain masks)",
              "additionalProperties": false,
              "properties": {
                "coverage": {"type": "number", "minimum": 0, "maximum": 1},
                "gap_model": {"enum": ["parametric", "periodic"], "description": "parametric: exponential up/gap periods; periodic (B-48): up for coverage x period_h of every period_h, random phase"},
                "mean_gap_h": {"type": "number", "exclusiveMinimum": 0},
                "period_h": {"type": "number", "exclusiveMinimum": 0, "description": "periodic model: the orbit period (h)"}
              }
            },
            "intervention_scale": {"type": "number", "minimum": 0, "description": "B-48 sensitivity: strategic policies' intervention count k becomes Poisson(s k), or the hazard rate is scaled by s; default 1"},
            "mast": {
              "type": ["object", "null"],
              "properties": {"site": {"type": "string"}, "height_m": {"type": "number"}, "range_km": {"type": "number"}}
            },
            "supervised_policy": {"enum": ["strict", "strategic", "strategic+avoid", "strategic+bound"]},
            "bound_h": {"type": ["number", "null"], "minimum": 0, "description": "strategic+bound (B-57): defer a job when a route sample's forecast wait at the rover's pass exceeds this (h); null = no limit"},
            "bound_never": {"enum": ["refuse", "strategic"], "description": "strategic+bound: a never-linked sample refuses its routes (default) or is left out of the check"},
            "never_linked": {"enum": ["redraw", "strand", "rescue"], "description": "strategic policies: an intervention on a never-linked sample makes the job impossible and dispatch tries again (default), strands the rover for the rest of the year, or (rescue) is resolved after rescue_h"},
            "rescue_scope": {"enum": ["never_linked", "any"], "description": "with never_linked 'rescue' (B-60): help only at never-linked samples (default) or for every strategic intervention wait longer than rescue_h"},
            "rescue_h": {"type": "number", "minimum": 0, "description": "never_linked 'rescue' (B-59, required with it): hours until help arrives at a never-linked point (a rover parked as a local relay, a crew, a tow); the helper's own time is not modelled, which is optimistic"},
            "helpers": {
              "type": "object",
              "description": "B-62, with never_linked 'rescue' and rescue_scope 'any' (mode dte, criterion any_part, no mast): k modelled helpers. A strategic intervention wait longer than rescue_h calls one; it drives from home to the held sample's best parking point (parking file), waits for that point's DTE link, serves service_h and drives home (first-fit booking); the rover is released when the service ends, if that is before the wait's natural end. from_fleet true takes the helpers out of the hauling fleet (last vehicles of their class)",
              "additionalProperties": false,
              "properties": {
                "n": {"type": "integer", "minimum": 1},
                "home": {"enum": ["BASE"]},
                "service_h": {"type": "number", "minimum": 0, "description": "hours of one intervention session through the parked helper (default 1, Assumed)"},
                "parking": {"type": "string", "description": "parking-v1 file (default data/comms/connecting_ridge/parking-v1.json)"},
                "from_fleet": {"type": "boolean"},
                "class": {"enum": ["LTV", "HAUL", "MICRO"], "description": "the helper's vehicle class (speed; from_fleet removes one of this class); default LTV"}
              }
            },
            "defer_wait_h": {"type": ["number", "null"], "minimum": 0, "description": "jobs with a longer planned link wait are deferred (default 24 h, Assumed); null = never defer"},
            "start_year": {"enum": [2028, 2029, 2030, 2031]},
            "start_h": {"type": "number", "minimum": 0}
          }
        }
      }
    },
    "compact": {
      "type": "object",
      "required": [
        "phase"
      ],
      "additionalProperties": false,
      "description": "The web page's controls. Expanded from lunarsim.phases.PHASES[phase] exactly as web/sim.js makeScenario().",
      "properties": {
        "format": true,
        "version": true,
        "form": {
          "const": "compact"
        },
        "name": {
          "type": "string"
        },
        "phase": {
          "enum": [
            "P1",
            "P2",
            "P3"
          ]
        },
        "bulk_t_per_year": {
          "type": "number",
          "minimum": 0,
          "description": "Phase bulk flows scaled to this total; 0 = none."
        },
        "fleet": {
          "type": "array",
          "items": {
            "$ref": "#/$defs/fleetEntry"
          }
        },
        "night_fraction": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "rtt_s": {
          "type": "number",
          "minimum": 0,
          "description": "Round trip = 2 * one_way_latency_s + ground_delay_s (ground delay kept at 2.4 s)."
        },
        "n_operators": {
          "type": "integer",
          "minimum": 0
        },
        "other_duty_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "mtbf_mult": {
          "type": "number",
          "exclusiveMinimum": 0
        },
        "common_standard_share": {
          "type": "number",
          "minimum": 0,
          "maximum": 1
        },
        "marketplace": {
          "type": "object",
          "description": "Marketplace mechanism options (not Scenario fields). Short names team/night are aliases of team_lift/night_aware.",
          "additionalProperties": false,
          "properties": {
            "bundling": {
              "type": "boolean"
            },
            "consolidate": {
              "type": "boolean"
            },
            "anticipate": {
              "type": "boolean"
            },
            "backhaul": {
              "type": "boolean"
            },
            "priority": {
              "type": "boolean"
            },
            "team_lift": {
              "type": "boolean"
            },
            "team": {
              "type": "boolean"
            },
            "night_aware": {
              "type": "boolean"
            },
            "night": {
              "type": "boolean"
            }
          }
        }
      }
    }
  }
}
