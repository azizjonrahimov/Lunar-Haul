{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azizjonrahimov.github.io/Lunar-Haul/schemas/horizons-v1.schema.json",
  "title": "lunarsim-horizons v1",
  "description": "Terrain horizon by grid bearing at named points, for the 'Earth's sky' view (writer tools/comms/earth_link.py outlines, B-58): horizon_deg[k] is the elevation of the skyline above the local horizontal at the antenna for grid bearing bearing.start_deg + k x bearing.step_deg. Also the monthly link fractions of the ISRU->CONSTR leg, 2028-2031.",
  "type": "object",
  "required": ["format", "version", "terrain", "bearing", "antenna_m", "points", "isru_constr_monthly", "sources"],
  "properties": {
    "format": {"const": "lunarsim-horizons"},
    "version": {"const": 1},
    "terrain": {"type": "string"},
    "description": {"type": "string"},
    "bearing": {
      "type": "object",
      "required": ["start_deg", "step_deg", "n"],
      "properties": {"start_deg": {"type": "number"}, "step_deg": {"type": "number", "exclusiveMinimum": 0},
                     "n": {"type": "integer", "minimum": 2}, "convention": {"type": "string"}}
    },
    "antenna_m": {"type": "number", "minimum": 0},
    "points": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "required": ["kind", "xy_m", "z_m", "horizon_deg"],
        "properties": {
          "kind": {"type": "string"},
          "xy_m": {"type": "array", "minItems": 2, "maxItems": 2, "items": {"type": "number"}},
          "z_m": {"type": "number"},
          "sample": {"type": "integer", "minimum": 0},
          "legs": {"type": "array", "items": {"type": "string"}},
          "horizon_deg": {"type": "array", "minItems": 2, "items": {"type": "number", "minimum": -90, "maximum": 90}}
        }
      }
    },
    "isru_constr_monthly": {
      "type": "object",
      "required": ["months", "leg", "all_samples", "all_samples_that_ever_link", "dark_sample"],
      "properties": {
        "months": {"type": "array", "items": {"type": "string", "pattern": "^20[0-9]{2}-[01][0-9]$"}},
        "leg": {"type": "string"},
        "n_samples": {"type": "integer"},
        "never_linked_samples": {"type": "integer"},
        "all_samples": {"$ref": "#/$defs/fractions"},
        "all_samples_that_ever_link": {"$ref": "#/$defs/fractions"},
        "dark_sample": {"$ref": "#/$defs/fractions"},
        "note": {"type": "string"}
      }
    },
    "sources": {"type": "object"},
    "generated": {"type": "object"}
  },
  "$defs": {
    "fractions": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}}
  }
}
