{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azizjonrahimov.github.io/Lunar-Haul/schemas/trajectories-v1.schema.json",
  "title": "lunarsim-trajectories v1",
  "description": "Descent episodes for the 3D landing lab, replayed from the Monte Carlo seeds of lunar/Descent-v0 (writer: lunarsim/lander/trajectories.py). Positions and velocities at 10 Hz (t = 0, 0.1, ... then t_end_s); per 0.2 s guidance step: throttle, thrust direction, attitude quaternion, propellant, altimeter reading and reward terms. Extra rules checked by trajectories.validate(): array lengths agree with n_samples / n_steps, unit vectors, reward terms sum to the score.",
  "type": "object",
  "required": ["format", "version", "env", "env_version", "frame", "sampling", "plume", "pilots"],
  "properties": {
    "format": {"const": "lunarsim-trajectories"},
    "version": {"const": 1},
    "env": {"type": "string"},
    "env_version": {"type": "integer"},
    "frame": {"type": "string"},
    "sampling": {"type": "object"},
    "fields": {"type": "object"},
    "selection": {"type": "string"},
    "touchdown_box": {"type": "object"},
    "plume": {
      "type": "object",
      "additionalProperties": {
        "type": "object",
        "required": ["t_max_n", "keepout_model", "dust_onset_altitude_m", "f33_onset_altitude_m"],
        "properties": {
          "t_max_n": {"type": "number"},
          "t_min_n": {"type": "number"},
          "m_gate_kg": {"type": "number"},
          "keepout_model": {"type": "string"},
          "dust_onset_altitude_m": {"type": ["number", "null"]},
          "f33_onset_altitude_m": {
            "type": "object",
            "required": ["value", "flag", "source"],
            "properties": {"value": {"type": ["number", "null"]}, "flag": {"enum": ["Spec", "Measured", "Assumed", "Modelled"]}, "source": {"type": "string"}}
          }
        }
      }
    },
    "pilots": {"type": "array", "minItems": 1, "items": {"$ref": "#/$defs/pilot"}}
  },
  "$defs": {
    "vec3": {"type": "array", "items": {"type": "number"}, "minItems": 3, "maxItems": 3},
    "series": {"type": "array", "items": {"type": "number"}},
    "pilot": {
      "type": "object",
      "required": ["cls", "pilot", "reward_variant", "obs_version", "monte_carlo", "episodes"],
      "properties": {
        "cls": {"enum": ["CLPS", "MK1", "LARGE"]},
        "pilot": {"type": "string"},
        "label": {"type": "string"},
        "reward_variant": {"type": "string"},
        "obs_version": {"enum": [2, 3]},
        "monte_carlo": {
          "type": "object",
          "required": ["file", "sha256", "n", "pass_rate"],
          "properties": {"file": {"type": "string"}, "sha256": {"type": "string"}, "n": {"type": "integer"}, "seed0": {"type": ["integer", "null"]}, "env_version": {"type": ["integer", "null"]}, "pass_rate": {"type": "number"}}
        },
        "episodes": {"type": "array", "items": {"$ref": "#/$defs/episode"}}
      }
    },
    "episode": {
      "type": "object",
      "required": ["pick", "seed", "t_end_s", "n_steps", "n_samples", "pos_m", "vel_mps", "throttle", "thrust_dir", "quat_wxyz", "prop_kg", "alt_meas_m", "reward", "outcome", "miss_m", "matches_monte_carlo"],
      "properties": {
        "pick": {"enum": ["p10", "p50", "p90", "first_failure"]},
        "seed": {"type": "integer"},
        "target_miss_m": {"type": ["number", "null"]},
        "miss_m": {"type": "number"},
        "matches_monte_carlo": {"type": "boolean"},
        "t_end_s": {"type": "number", "minimum": 0},
        "n_steps": {"type": "integer", "minimum": 1},
        "n_samples": {"type": "integer", "minimum": 2},
        "pos_m": {"type": "array", "items": {"$ref": "#/$defs/vec3"}},
        "vel_mps": {"type": "array", "items": {"$ref": "#/$defs/vec3"}},
        "throttle": {"$ref": "#/$defs/series"},
        "thrust_dir": {"type": "array", "items": {"$ref": "#/$defs/vec3"}},
        "quat_wxyz": {"type": "array", "items": {"type": "array", "items": {"type": "number"}, "minItems": 4, "maxItems": 4}},
        "prop_kg": {"$ref": "#/$defs/series"},
        "alt_meas_m": {"$ref": "#/$defs/series"},
        "reward": {
          "type": "object",
          "required": ["eta_per_step", "track", "effort", "low_alt", "terminal", "score"],
          "properties": {
            "eta_per_step": {"type": "number"},
            "track": {"$ref": "#/$defs/series"},
            "effort": {"$ref": "#/$defs/series"},
            "low_alt": {"$ref": "#/$defs/series"},
            "terminal": {"$ref": "#/$defs/series"},
            "score": {"type": "number"}
          }
        },
        "outcome": {
          "type": "object",
          "required": ["miss_m", "v_td", "ok", "touchdown_ok", "failure_kind"],
          "properties": {"failure_kind": {"enum": [null, "velocity", "tilt", "offpad", "sensor", "timeout", "lost"]}}
        },
        "episode": {"type": "object"}
      }
    }
  }
}
