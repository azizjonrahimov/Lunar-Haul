{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://azizjonrahimov.github.io/Lunar-Haul/schemas/catalog-v1.schema.json",
  "title": "lunarsim-catalog v1",
  "description": "Vehicle and site catalogue: real dimensions for the 3D models and the capacities, speeds and descent constants of the engine, every number a sourced quantity. Loader and dependency-free validator: lunarsim/catalog.py. Extra rules the validator enforces beyond this schema: ids are unique; Spec and Measured quantities have a URL in 'source'; material tags exist in 'materials'; no bare number appears outside a quantity; the engine link (catalog.engine_mismatches) is empty.",
  "type": "object",
  "required": ["format", "version", "materials", "entries"],
  "properties": {
    "format": {"const": "lunarsim-catalog"},
    "version": {"const": 1},
    "description": {"type": "string"},
    "flags": {"type": "object", "additionalProperties": {"type": "string"}},
    "materials": {
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {"$ref": "#/$defs/material"}
    },
    "entries": {
      "type": "array",
      "minItems": 1,
      "items": {"$ref": "#/$defs/entry"}
    }
  },
  "additionalProperties": false,
  "$defs": {
    "flag": {"enum": ["Spec", "Measured", "Assumed", "Modelled"]},
    "quantity": {
      "type": "object",
      "required": ["value", "unit", "flag", "source"],
      "properties": {
        "value": {"type": "number", "minimum": 0},
        "unit": {"type": "string"},
        "flag": {"$ref": "#/$defs/flag"},
        "source": {"type": "string", "minLength": 1, "description": "URL (required for Spec and Measured) or the reasoning behind an Assumed / Modelled value"},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "count": {
      "allOf": [{"$ref": "#/$defs/quantity"}, {"properties": {"value": {"type": "integer", "minimum": 0}}}]
    },
    "boolean_quantity": {
      "type": "object",
      "required": ["value", "unit", "flag", "source"],
      "properties": {
        "value": {"type": "boolean"},
        "unit": {"type": "string"},
        "flag": {"$ref": "#/$defs/flag"},
        "source": {"type": "string", "minLength": 1},
        "note": {"type": "string"}
      },
      "additionalProperties": false
    },
    "unit_interval": {
      "allOf": [{"$ref": "#/$defs/quantity"}, {"properties": {"value": {"type": "number", "minimum": 0, "maximum": 1}}}]
    },
    "material": {
      "type": "object",
      "required": ["description", "base_color_linear", "metalness", "roughness"],
      "properties": {
        "description": {"type": "string"},
        "base_color_linear": {
          "type": "object",
          "required": ["value", "unit", "flag", "source"],
          "properties": {
            "value": {"type": "array", "items": {"type": "number", "minimum": 0, "maximum": 1}, "minItems": 3, "maxItems": 3},
            "unit": {"type": "string"},
            "flag": {"$ref": "#/$defs/flag"},
            "source": {"type": "string", "minLength": 1}
          },
          "additionalProperties": false
        },
        "metalness": {"$ref": "#/$defs/unit_interval"},
        "roughness": {"$ref": "#/$defs/unit_interval"}
      },
      "additionalProperties": false
    },
    "dims": {
      "type": "object",
      "minProperties": 1,
      "properties": {
        "height_m": {"$ref": "#/$defs/quantity"},
        "diameter_m": {"$ref": "#/$defs/quantity"},
        "length_m": {"$ref": "#/$defs/quantity"},
        "width_m": {"$ref": "#/$defs/quantity"},
        "leg_count": {"$ref": "#/$defs/count"},
        "leg_span_m": {"$ref": "#/$defs/quantity"},
        "wheel_count": {"$ref": "#/$defs/count"},
        "wheel_d_m": {"$ref": "#/$defs/quantity"},
        "wheelbase_m": {"$ref": "#/$defs/quantity"},
        "track_m": {"$ref": "#/$defs/quantity"},
        "deck_height_m": {"$ref": "#/$defs/quantity"},
        "ground_clearance_m": {"$ref": "#/$defs/quantity"},
        "berm_height_m": {"$ref": "#/$defs/quantity"},
        "berm_crest_m": {"$ref": "#/$defs/quantity"},
        "berm_slope_deg": {"$ref": "#/$defs/quantity"},
        "berm_base_m": {"$ref": "#/$defs/quantity"},
        "berm_radius_m": {"$ref": "#/$defs/quantity"},
        "array_width_m": {"$ref": "#/$defs/quantity"},
        "array_height_m": {"$ref": "#/$defs/quantity"}
      },
      "additionalProperties": false
    },
    "gate": {
      "type": "object",
      "description": "Descent constants at the SPLICE gate, equal to lunarsim/lander/classes.py (values and flags).",
      "required": ["m_gate_kg", "prop_gate_kg", "t_max_n", "t_min_n", "isp_s"],
      "properties": {
        "m_gate_kg": {"$ref": "#/$defs/quantity"},
        "prop_gate_kg": {"$ref": "#/$defs/quantity"},
        "t_max_n": {"$ref": "#/$defs/quantity"},
        "t_min_n": {"$ref": "#/$defs/quantity"},
        "isp_s": {"$ref": "#/$defs/quantity"}
      },
      "additionalProperties": false
    },
    "entry": {
      "type": "object",
      "required": ["id", "kind", "name", "reference_vehicle", "representative", "dims", "propellant", "plume_class", "materials"],
      "properties": {
        "id": {"type": "string", "minLength": 1},
        "kind": {"enum": ["lander", "rover", "base", "reference"]},
        "name": {"type": "string"},
        "engine_class": {"type": "string", "description": "the engine class this entry describes (VEHICLE_CLASSES or LANDER_TYPES key); defaults to id"},
        "reference_vehicle": {
          "type": "object",
          "required": ["name", "url", "status"],
          "properties": {
            "name": {"type": "string"},
            "url": {"type": "string", "pattern": "^https?://"},
            "status": {"enum": ["flown", "built", "in_development", "concept"]}
          },
          "additionalProperties": false
        },
        "representative": {"type": "boolean", "description": "true when the real shape is not published and the 3D model is a labelled stand-in"},
        "representative_note": {"type": "string"},
        "dims": {"$ref": "#/$defs/dims"},
        "mass_kg": {"$ref": "#/$defs/quantity"},
        "capacity_kg": {"$ref": "#/$defs/quantity"},
        "max_item_kg": {"$ref": "#/$defs/quantity"},
        "speed_kmh": {"$ref": "#/$defs/quantity"},
        "night_ops": {"$ref": "#/$defs/boolean_quantity"},
        "power_kw": {"$ref": "#/$defs/quantity"},
        "gate": {"$ref": "#/$defs/gate"},
        "propellant": {"type": "string"},
        "plume_class": {"enum": ["hydrolox", "methalox", "hypergolic", "none"]},
        "materials": {"type": "array", "items": {"type": "string"}, "minItems": 1},
        "notes": {"type": "string"}
      },
      "additionalProperties": false,
      "allOf": [
        {
          "if": {"properties": {"kind": {"const": "lander"}}},
          "then": {"required": ["gate", "capacity_kg", "max_item_kg"], "properties": {"plume_class": {"enum": ["hydrolox", "methalox", "hypergolic"]}}}
        },
        {
          "if": {"properties": {"kind": {"const": "rover"}}},
          "then": {"required": ["capacity_kg", "speed_kmh", "night_ops"]}
        }
      ]
    }
  }
}
